<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Внешний круг (полупрозрачный) -->
    <item>
        <shape android:shape="oval">
            <size android:width="64dp" android:height="64dp"/>
            <stroke android:width="2dp" android:color="#80FFFFFF"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
    <!-- Внутренний круг (белый, с отступом) -->
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval">
            <size android:width="48dp" android:height="48dp"/>
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
</layer-list>