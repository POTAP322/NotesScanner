<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Чекбокс-->
    <CheckBox
        android:id="@+id/checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:buttonTint="#C3CCFF"
        android:scaleX="1.5"
        android:scaleY="1.5" />

    <!-- Превью (126x168 dp, пропорция 3:4) -->
    <ImageView
        android:id="@+id/ivPreview"
        android:layout_width="126dp"
        android:layout_height="165dp"
        android:src="@drawable/ic_image"
        android:scaleType="centerCrop" />

    <!-- Информация о файле + облачко -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">

        <!-- Облачко (в правом верхнем углу контейнера) -->
        <ImageButton
            android:id="@+id/btnCloud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_no_cloud"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:contentDescription="Загрузить в облако" />

        <!-- Название (под облачком или слева от него) -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/btnCloud"
            android:layout_alignParentTop="true"
            android:textSize="16sp"
            android:fontFamily="@font/jost"
            android:textColor="#C3CCFF"
            android:text="Название конспекта"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Дата -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTitle"
            android:layout_alignParentStart="true"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="#C3CCFF"
            android:fontFamily="@font/jost"
            android:text="01.01.2024" />

        <!-- Размер -->
        <TextView
            android:id="@+id/tvSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvDate"
            android:layout_alignParentStart="true"
            android:text="0 MB"
            android:fontFamily="@font/jost"
            android:textColor="#C3CCFF"
            android:textSize="12sp" />

    </RelativeLayout>

</LinearLayout>