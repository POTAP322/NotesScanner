<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Чекбокс -->
    <CheckBox
        android:id="@+id/checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:buttonTint="#C3CCFF"
        android:scaleX="1.5"
        android:scaleY="1.5" />

    <!-- Превью -->
    <ImageView
        android:id="@+id/ivPreview"
        android:layout_width="126dp"
        android:layout_height="165dp"
        android:src="@drawable/ic_image"
        android:scaleType="centerCrop" />

    <!-- Информация о файле + облачко -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="165dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp">

        <!-- 1. Название  -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:ellipsize="end"
            android:fontFamily="@font/jost"
            android:maxLines="2"
            android:text="Название конспекта"
            android:textColor="#C3CCFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 2. Дата -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTitle"
            android:layout_alignParentStart="true"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/jost"
            android:text="01.01.2024"
            android:textColor="#80C3CCFF"
            android:textSize="12sp" />

        <!-- 3. Размер  -->
        <TextView
            android:id="@+id/tvSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTitle"
            android:layout_toEndOf="@id/tvDate"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/jost"
            android:text="• 2.5 MB"
            android:textColor="#80C3CCFF"
            android:textSize="12sp" />

        <!-- 4. Облачко  -->
        <ImageButton
            android:id="@+id/btnCloud"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Загрузить в облако"
            android:padding="8dp"
            android:src="@drawable/ic_no_cloud"
            app:tint="#C3CCFF" />

    </RelativeLayout>

</LinearLayout>