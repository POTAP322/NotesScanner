<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Заголовок -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Предпросмотр"
        android:textSize="32sp"
        android:fontFamily="@font/jost"
        android:textColor="#2644F7"
        android:gravity="center"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp"/>

    <!-- Счётчик страниц -->
    <TextView
        android:id="@+id/pageCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Страниц: 0"
        android:textAlignment="center"
        android:padding="12dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#2644F7"
        android:background="#FFFFFF"
        android:layout_marginBottom="1dp"/>

    <!-- Предпросмотр фото -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="0dp"
        android:clipToPadding="false"/>

    <!-- Нижняя панель с иконками -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- Иконка поделиться (слева) -->

        <!-- Иконка сохранить (по центру) -->
        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="20dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Поделиться"
            android:src="@drawable/ic_share"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/ic_save"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Сохранить"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Иконка завершить (справа) -->
        <ImageButton
            android:id="@+id/btnFinish"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginEnd="20dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Завершить"
            android:src="@drawable/ic_done"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>