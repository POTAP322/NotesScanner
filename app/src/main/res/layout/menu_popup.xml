<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp">

    <ImageButton
        android:id="@+id/btnSave"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/circle_blue_border"
        android:src="@drawable/ic_download_40dp"
        android:padding="14dp"
        android:contentDescription="Сохранить"
        app:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/btnShare"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/circle_blue_border"
        android:src="@drawable/ic_share_40dp"
        android:padding="14dp"
        android:contentDescription="Отправить"
        app:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/btnFinish"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/circle_blue_border"
        android:src="@drawable/ic_done_40dp"
        android:padding="14dp"
        android:contentDescription="Завершить"
        app:tint="@android:color/white" />

</LinearLayout>