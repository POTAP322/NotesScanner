<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Мои конспекты"
            android:textSize="32sp"
            android:fontFamily="@font/jost"
            android:textColor="#2644F7"
            android:gravity="center" />


    </LinearLayout>

    <!-- Список конспектов -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay" />

    <!-- Нижняя панель по стандарту -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/normalPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:visibility="visible">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnToProcessing"
            android:layout_width="61dp"
            android:layout_height="61dp"
            android:background="@drawable/btn_round"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="+"
            android:textColor="#C3CCFF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:padding="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnSort"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginEnd="20dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Сортировка"
            android:padding="10dp"
            android:src="@drawable/ic_sort"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Панель действий при выделении -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/selectionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="81dp"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:visibility="gone">

        <!-- Кнопка Поделиться (Слева) -->
        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/ic_share"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Поделиться"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Кнопка Удалить (Справа) -->
        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/ic_delete_58dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Удалить"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>